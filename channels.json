-black);             border: 1px solid var(--border-color);             border-radius: 24px;             padding: 40px 30px;             box-shadow: 0 30px 60px rgba(0,0,0,0.8);             text-align: center;         }                  /* أيقونة التشغيل الكبيرة */         .play-wrapper {             position: relative;             width: 160px;             height: 160px;             margin: 0 auto 30px;             cursor: pointer;             transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);         }                  .play-wrapper:hover {             transform: scale(1.08);         }                  .play-wrapper:active {             transform: scale(0.96);         }                  /* الدائرة الخلفية المتوهجة */         .glow-circle {             position: absolute;             top: 0;             left: 0;             width: 100%;             height: 100%;             border-radius: 50%;             background: linear-gradient(135deg, #667eea 0%, var(--accent) 100%);             box-shadow: 0 0 40px rgba(139, 92, 246, 0.4);             opacity: 0.6;             animation: pulse 2s infinite;         }                  /* الدائرة الزجاجية الأمامية */         .glass-circle {             position: absolute;             top: 12px;             left: 12px;             width: 136px;             height: 136px;             border-radius: 50%;             background: rgba(255, 255, 255, 0.08);             backdrop-filter: blur(12px);             -webkit-backdrop-filter: blur(12px);             border: 1px solid rgba(255, 255, 255, 0.15);             border-top: 1px solid rgba(255, 255, 255, 0.4);             box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);             display: flex;             justify-content: center;             align-items: center;             z-index: 2;         }                  .glass-circle i {             font-size: 70px;             color: #fff;             margin-right: 8px;             filter: drop-shadow(0 2px 10px rgba(0,0,0,0.5));             transition: all 0.3s;         }                  .play-wrapper:hover .glass-circle i {             text-shadow: 0 0 20px rgba(255,255,255,0.8);             transform: scale(1.02);         }                  /* عنوان الفيديو */         .video-title {             font-size: 1.2rem;             font-weight: 600;             color: var(--text-white);             margin: 20px 0 10px;             padding: 0 10px;         }                  /* معلومات إضافية */         .info-text {             color: var(--text-dim);             font-size: 0.85rem;             margin-bottom: 25px;             display: flex;             align-items: center;             justify-content: center;             gap: 8px;         }                  .info-text i {             font-size: 1rem;         }                  /* زر التشغيل البديل */         .play-btn-alt {             width: 100%;             background: linear-gradient(135deg, var(--accent), #6d28d9);             color: white;             padding: 14px;             border: none;             border-radius: 14px;             font-size: 1rem;             font-weight: 700;             cursor: pointer;             font-family: 'Cairo', sans-serif;             display: flex;             align-items: center;             justify-content: center;             gap: 10px;             box-shadow: 0 10px 20px rgba(139, 92, 246, 0.2);             transition: 0.3s;             margin-top: 20px;         }                  .play-btn-alt:hover {             transform: translateY(-2px);             box-shadow: 0 15px 30px rgba(139, 92, 246, 0.3);         }                  /* رسالة الحالة */         .status-msg {             margin-top: 20px;             color: var(--text-dim);             font-size: 0.85rem;             min-height: 45px;             transition: opacity 0.3s;             background: rgba(139, 92, 246, 0.05);             padding: 12px;             border-radius: 12px;             border: 1px solid var(--border-color);         }                  /* Footer */         .footer {             text-align: center;             margin-top: 35px;             color: #333;             font-size: 0.8rem;             font-weight: 600;         }                  /* Animations */         @keyframes pulse {             0% { transform: scale(0.95); opacity: 0.5; }             50% { transform: scale(1.05); opacity: 0.8; }             100% { transform: scale(0.95); opacity: 0.5; }         }                  @keyframes spin {             100% { transform: rotate(360deg); }         }                  .loader {             animation: spin 1s linear infinite;         }                  /* تأثير الدخول */         @keyframes fadeInUp {             from {                 opacity: 0;                 transform: translateY(30px);             }             to {                 opacity: 1;                 transform: translateY(0);             }         }                  .card-main {             animation: fadeInUp 0.6s ease-out;         }     </style> </head> <body oncontextmenu=\"return false;\">  <div class=\"main-container\">     <div class=\"header-brand\">         <h1>Arix Player</h1>         <p>تجربة مشاهدة فائقة الجودة</p>     </div>      <div class=\"card-main\">                  <!-- الزر الدائري الرئيسي -->         <div class=\"play-wrapper\" onclick=\"startStream()\">             <div class=\"glow-circle\"></div>             <div class=\"glass-circle\">                 <i class='bx bx-play-circle' id=\"btnIcon\"></i>             </div>         </div>                  <!-- عنوان الفيديو -->         <div class=\"video-title\">             <i class='bx bxs-video' style=\"color: var(--accent);\"></i>             جاهز للتشغيل         </div>                  <div class=\"info-text\">             <i class='bx bx-shield-alt'></i>             <span>مشفر بالكامل | آمن 100%</span>         </div>                  <!-- زر تشغيل بديل -->         <button class=\"play-btn-alt\" onclick=\"startStream()\">             <i class='bx bx-play'></i>             تشغيل الفيديو الآن         </button>                  <!-- رسالة الحالة -->         <div class=\"status-msg\" id=\"statusMsg\">             <i class='bx bx-info-circle'></i>             اضغط على الزر لبدء المشاهدة         </div>              </div>          <div class=\"footer\">ARIX PLAYER &copy; 2026 • DARK EDITION</div> </div>  <script>     // -----------------------------------------------     // تم تعديل الرابط ليصبح intent يدوي ثابت     // يمكنك تغيير هذا الرابط إلى أي intent:// تريده     // -----------------------------------------------     const deepLink = \"intent://video?json=c/NajpsEsvqjHSuAq3hnly+Kx7H9K0DJJ1ZiS8VjFSl+4/59cVBuhwRrCzot3qnsfEPlOf3Qz6xIgGKazwPELCQz4WbvoyEMnj7J65tikwCQ5GEsJTPwRzUJUDTgwY2iOoNpcv8HnzXd02ecGDpFcmC5o89fYSm0nwGiEGobvjL0HBT077fwZiliqKXv4M/uM7cLtMxlYUtVclyl01EOMcc/y/erKc/LvxwG61yL9to7z6HFKKbmFBUjA4Z314Af#Intent;scheme=myapp;package=com.arix.player;end\";          // رابط المتجر في حال عدم وجود التطبيق     const playStore = \"https://play.google.com/store/apps/details?id=com.arix.player\";          let appOpened = false;      // إذا المستخدم طلع من الصفحة (يعني التطبيق انفتح)     document.addEventListener(\"visibilitychange\", function() {         if (document.hidden) {             appOpened = true;         }     });      function startStream() {         if(!deepLink) {             document.getElementById('statusMsg').innerHTML = '<i class=\"bx bx-error-circle\"></i> خطأ: الرابط غير متوفر';             document.getElementById('statusMsg').style.color = \"#ff4444\";             return;         }                  const icon = document.getElementById('btnIcon');         icon.classList.remove('bx-play-circle');         icon.classList.add('bx-loader-alt', 'loader');                  document.getElementById('statusMsg').innerHTML = '<i class=\"bx bx-loader-alt loader\"></i> جاري فتح المشغل...';         document.getElementById('statusMsg').style.color = \"var(--accent)\";                  // محاولة فتح الت